# Database URL for PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/mydb"

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
# Generate with: pnpm dlx @better-auth/cli secret
BETTER_AUTH_SECRET=
# Comma-separated list of origins allowed for callbacks/redirects
# Example: http://localhost:3000,https://app.example.com
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Resend API key for email delivery (https://resend.com/api-keys)
RESEND_API_KEY=
# Email sender address (must be verified in Resend)
EMAIL_FROM=noreply@vitta.app

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dodo Payments (one-time lifetime payment for Vitta Pro)
# Test keys from https://app.dodopayments.com/dashboard/developer/api-keys
DODO_PAYMENTS_API_KEY=
# Webhook signing secret. Create endpoint https://YOUR_DOMAIN/api/auth/dodopayments/webhooks
# at https://app.dodopayments.com/dashboard/developer/webhooks
DODO_PAYMENTS_WEBHOOK_SECRET=
# Product ID of the "Vitta Pro Lifetime" one-time product (starts with pdt_)
DODO_PRODUCT_PRO_LIFETIME=

# Umami (analítica sin cookies, https://cloud.umami.is). Vacío = sin analítica.
VITE_UMAMI_WEBSITE_ID=
# Dominios donde se cuentan visitas (separados por coma)
VITE_UMAMI_DOMAINS=vitta.app
